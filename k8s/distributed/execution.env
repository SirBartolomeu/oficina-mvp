ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Postgres
Observability__OtlpEndpoint=http://otel-collector:4317
Observability__TraceSampleRatio=0.1
Observability__MetricExportIntervalSeconds=60
AWS__Region=us-east-1
AWS_EC2_METADATA_DISABLED=true
Messaging__CommandsQueueUrl=REPLACE_WITH_EXECUTION_COMMANDS_QUEUE_URL
Messaging__OsEventsQueueUrl=REPLACE_WITH_OS_EVENTS_QUEUE_URL
