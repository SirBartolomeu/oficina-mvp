ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Postgres
Database__UseMigrations=true
SeedDemoData=false
Jwt__Issuer=OficinaMvp
Jwt__Audience=OficinaMvpClients
Jwt__ExpirationMinutes=120
AdminCredentials__Username=admin
Notifications__Mode=Log
Execution__BaseUrl=http://execution-api:80
Observability__OtlpEndpoint=http://otel-collector:4317
Observability__TraceSampleRatio=0.1
Observability__MetricExportIntervalSeconds=60
AWS__Region=us-east-1
AWS_EC2_METADATA_DISABLED=true
Messaging__BillingQueueUrl=REPLACE_WITH_BILLING_WORKORDERS_QUEUE_URL
Messaging__ExecutionCommandsQueueUrl=REPLACE_WITH_EXECUTION_COMMANDS_QUEUE_URL
Messaging__OsEventsQueueUrl=REPLACE_WITH_OS_EVENTS_QUEUE_URL
